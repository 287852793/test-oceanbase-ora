# OceanBase Docker 运行配置
# 修改后重新执行 ./run.sh 即可（容器已存在时会复用）

# 镜像（官方镜像，无需自行构建）
OB_IMAGE=oceanbase/oceanbase-ce:4.3.5-lts

# 容器与端口
CONTAINER_NAME=oceanbase-ora
HOST_PORT=2881

# 时区
TZ=Asia/Shanghai
TIMEZONE_FILE=/usr/share/zoneinfo/Asia/Shanghai

# 自定义网络（固定容器 IP，保证容器重建后 obd 配置仍可用）
# 容器内部 IP 仅用于 obd 自恢复，用户访问请使用 宿主机IP:HOST_PORT
DOCKER_NETWORK=oceanbase-ora-net
NETWORK_SUBNET=172.31.254.0/24
CONTAINER_IP=172.31.254.10

# 持久化目录（相对工程根目录）
VOLUME_ROOT=volumes
DATA_DIR=volumes/data/ob
OBD_CONF_DIR=volumes/conf/obd/cluster

# 镜像启动参数
MODE=mini
OB_MEMORY_LIMIT=10G
OB_SYSTEM_MEMORY=2G
OB_DATAFILE_SIZE=5G
OB_LOG_DISK_SIZE=5G
OB_CLUSTER_NAME=obcluster
OB_SYS_PASSWORD=root123456

# 镜像自带的 MySQL 模式 test 租户（占用小规格，为 Oracle 租户预留资源）
OB_TENANT_NAME=test
OB_TENANT_MIN_CPU=1
OB_TENANT_MEMORY_SIZE=2G
OB_TENANT_LOG_DISK_SIZE=2G
# test 租户默认会占用 sys 租户之外的剩余 CPU，run.sh 会将其 MAX_CPU 限制为该值
TEST_TENANT_MAX_CPU=1

# Oracle 模式租户
ORA_TENANT=ora_tenant
ORA_UNIT=ora_unit
ORA_POOL=ora_pool
ORA_CPU=2
ORA_MEMORY=4G
ORA_LOG_DISK=2G
ORA_SYS_PASSWORD=oracle123456

# 业务用户
APP_USER=appuser
APP_PASSWORD=app123456

# 是否在启动后自动初始化（./run.sh --no-init 可临时关闭）
AUTO_INIT=true

# 等待启动的超时时间（秒）
BOOT_TIMEOUT=600
